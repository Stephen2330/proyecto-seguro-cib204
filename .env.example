# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# Puerto del servicio
PORT=3000

# IAM: pon "true" para exigir token (requiere Keycloak configurado)
AUTH_ENABLED=false

# issuer que se valida en el token (host desde donde se pide el token)
KEYCLOAK_ISSUER=http://localhost:8080/realms/appmovil
# URL de las llaves publicas de Keycloak (alcanzable desde la red de contenedores)
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/appmovil/protocol/openid-connect/certs
